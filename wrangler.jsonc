{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scrapbook",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "keep_vars": true,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "scrapbook",
      "database_id": "9f72eb28-2229-4e60-acc1-6d6d4d15cee2",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS",
      "bucket_name": "scrapbook-assets"
    }
  ],
  "workflows": [
    {
      "name": "scrapbook-ingest",
      "binding": "INGEST_WORKFLOW",
      "class_name": "IngestWorkflow"
    }
  ],
  "env": {
    "production": {
      "name": "scrapbook",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "scrapbook",
          "database_id": "9f72eb28-2229-4e60-acc1-6d6d4d15cee2",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS",
          "bucket_name": "scrapbook-assets"
        }
      ],
      "workflows": [
        {
          "name": "scrapbook-ingest",
          "binding": "INGEST_WORKFLOW",
          "class_name": "IngestWorkflow"
        }
      ]
    }
  }
}
